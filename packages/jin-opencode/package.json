{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jin/opencode",
  "version": "0.0.0",
  "private": true,
  "description": "Jin architecture lifecycle for OpenCode, enforced on the server",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./service": "./src/service.ts"
  },
  "scripts": {
